@model FirstResponsiveWebAppMead.Models.StudentViewModel

@{
    ViewData["Title"] = "Assignment 6.1";
}

<h1>Assignment 6.1</h1>

@if (Model.AccessLevel < 2)
{
    <p>You do not have a sufficient access level to view this data.</p>
}
else if (Model.AccessLevel < 8)
{
    <h2>Students</h2>

    @foreach (var student in Model.Students)
    {
        <partial name="_StudentName" model="student" />
    }
}
else
{
    <h2>Hello Admin</h2>

    @foreach (var student in Model.Students)
    {
        <partial name="_StudentDetails" model="student" />
    }
}