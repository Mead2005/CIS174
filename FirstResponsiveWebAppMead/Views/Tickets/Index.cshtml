@model List<FirstResponsiveWebAppMead.Models.Ticket>

@{
    ViewData["Title"] = "ToDo Tickets";
}

<h1>ToDo Ticket List</h1>

<p>
    <a asp-action="Create">Create New Ticket</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>Name</th>
            <th>Description</th>
            <th>Sprint</th>
            <th>Points</th>
            <th>Status</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var ticket in Model)
        {
            <tr>
                <td>@ticket.Name</td>
                <td>@ticket.Description</td>
                <td>@ticket.SprintNumber</td>
                <td>@ticket.PointValue</td>
                <td>@ticket.Status</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@ticket.Id">Edit</a>

                    <form asp-action="Delete" method="post">
                        <input type="hidden" name="id" value="@ticket.Id" />
                        <button type="submit">Delete</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>