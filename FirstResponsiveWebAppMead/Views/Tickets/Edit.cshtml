@model FirstResponsiveWebAppMead.Models.Ticket

@{
    ViewData["Title"] = "Edit Ticket";
}

<h1>Edit Ticket</h1>

<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="Id" />

    <div class="mb-3">
        <label asp-for="Name"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Description"></label>
        <textarea asp-for="Description" class="form-control"></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="SprintNumber">Sprint Number</label>
        <input asp-for="SprintNumber" type="number" class="form-control" />
        <span asp-validation-for="SprintNumber" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="PointValue">Point Value</label>
        <input asp-for="PointValue" type="number" class="form-control" />
        <span asp-validation-for="PointValue" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Status"></label>
        <select asp-for="Status" class="form-select">
            <option>To Do</option>
            <option>In Progress</option>
            <option>QA</option>
            <option>Done</option>
        </select>
    </div>

    <button type="submit" class="btn btn-primary">Save Changes</button>
</form>

<p><a asp-action="Index">Back to Tickets</a></p>